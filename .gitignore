# Node
**/node_modules/
npm-debug.log*
package-lock.json

# VitePress documentation site build output & cache
docs-site/.vitepress/dist/
docs-site/.vitepress/cache/

# Legacy prototype node_modules (preserved as-is, not tracked)
legacy/js/node_modules/

# TypeScript build output
packages/*/dist/
dist/
*.tsbuildinfo

# Generated API documentation (regenerate with `pnpm docs`)
docs/api/

# Python
legacy/python/venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# Test artifacts
fixtures/**/actual.png
fixtures/**/diff.png

# EXP-007 render experiment — full 2048×2048 screenshots (reproducible, large)
analysis/phase3-rendering/**/*-full.png

# Downloaded MapLibre GL JS assets (not source, regenerate with wget)
tools/maplibre-gl.js
tools/maplibre-gl.css
*-results.json

# pnpm
.pnpm-store/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Real test tiles
fixtures/real-tiles/
fixtures/benchmark-cache/

# Phase 3 downloaded tile corpus (large — fetched by scripts, not committed)
fixtures/phase3-highzoom/

# Tools (large binaries — download separately)
tools/

# Planetiler auxiliary datasets (downloaded on first run, ~1.5GB)
data/

# Environment variables (secrets)
.env
.env.local

# Large analysis data (keep locally, don't ship)
analysis/**/*.csv
analysis/**/*.json
analysis/**/*.ipynb
!analysis/**/classification.json
!analysis/**/decoder-crosscheck.json
!analysis/phase3-pipeline/gd-tile-manifest.json
!analysis/phase3-rendering/render-diffs-summary.json
