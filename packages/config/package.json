{
  "name": "@tileguard/config",
  "version": "0.5.0-beta.1",
  "description": "Configuration loading, schema validation, and preset resolution for TileGuard",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "tileguard",
    "config",
    "configuration",
    "geospatial",
    "validation"
  ],
  "license": "MIT",
  "author": "Shreeharsh Shinde",
  "repository": {
    "type": "git",
    "url": "https://github.com/shindeshreeharsh/tileguard.git",
    "directory": "packages/config"
  },
  "homepage": "https://github.com/shindeshreeharsh/tileguard/tree/main/packages/config#readme",
  "bugs": "https://github.com/shindeshreeharsh/tileguard/issues",
