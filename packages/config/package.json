  },
  "sideEffects": false,
  "dependencies": {
    "@tileguard/core": "workspace:*",
    "jiti": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "5.4.5",
    "vitest": "^1.6.0"
  }
