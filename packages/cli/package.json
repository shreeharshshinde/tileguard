{
  "name": "@tileguard/cli",
  "version": "0.5.0-beta.1",
  "description": "Command-line interface for TileGuard — automated quality gates for geospatial software",
  "type": "module",
  "bin": {
    "tileguard": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "tileguard",
    "cli",
    "geospatial",
    "validation",
    "vector-tiles",
    "maplibre",
    "quality",
    "ci",
    "lint"
  ],
  "license": "MIT",
  "author": "Shreeharsh Shinde",
  "repository": {
    "type": "git",
    "url": "https://github.com/shindeshreeharsh/tileguard.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/shindeshreeharsh/tileguard#readme",
  "bugs": "https://github.com/shindeshreeharsh/tileguard/issues",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "dependencies": {
    "@tileguard/analysis": "workspace:*",
    "@tileguard/config": "workspace:*",
    "@tileguard/core": "workspace:*",
    "@tileguard/reporters": "workspace:*",
    "@tileguard/tile-rules": "workspace:*",
    "@tileguard/style-rules": "workspace:*",
    "commander": "12.1.0",
    "fast-glob": "3.3.3"
  },
  "devDependencies": {
    "@types/node": "26.1.0",
    "typescript": "5.4.5",
    "vitest": "1.6.1"
  }
}
