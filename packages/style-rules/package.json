{
  "name": "@tileguard/style-rules",
  "version": "0.5.0-beta.1",
  "description": "MapLibre style specification provider and 9 style lint rules for TileGuard",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./analysis": {
      "types": "./dist/analysis.d.ts",
      "import": "./dist/analysis.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "tileguard",
    "maplibre",
    "style",
    "lint",
    "geospatial",
    "validation",
    "quality"
  ],
  "license": "MIT",
  "author": "Shreeharsh Shinde",
  "repository": {
    "type": "git",
    "url": "https://github.com/shreeharshshinde/tileguard.git",
    "directory": "packages/style-rules"
  },
  "homepage": "https://github.com/shreeharshshinde/tileguard/tree/main/packages/style-rules#readme",
  "bugs": "https://github.com/shreeharshshinde/tileguard/issues",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "dependencies": {
    "@tileguard/core": "workspace:*",
    "@tileguard/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "5.4.5",
    "vitest": "^1.6.0"
  }
}
