{
  "name": "@tileguard/reporters",
  "version": "0.5.0-beta.1",
  "description": "Output reporters for TileGuard: text, JSON, Markdown, and HTML engineering reports",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "tileguard",
    "reporter",
    "geospatial",
    "diagnostics",
    "markdown",
    "html",
    "engineering-report"
  ],
  "license": "MIT",
  "author": "Shreeharsh Shinde",
  "repository": {
    "type": "git",
    "url": "https://github.com/shreeharshshinde/tileguard.git",
    "directory": "packages/reporters"
  },
  "homepage": "https://github.com/shreeharshshinde/tileguard/tree/main/packages/reporters#readme",
  "bugs": "https://github.com/shreeharshshinde/tileguard/issues",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "dependencies": {
    "@tileguard/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "5.4.5",
    "vitest": "^1.6.0"
  }
}
